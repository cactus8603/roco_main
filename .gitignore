# Local Git metadata used because the managed workspace exposes an empty .git mount.
/.git-local/
/.git/

# Python and test caches
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments and local runtime state
.venv/
venv/
.env
.env.*
.runtime_tmp/
tmp_trash
.agents/
.codex/

# Model weights, arrays and large binary artifacts
*.ckpt
*.h5
*.hdf5
*.npy
*.npz
*.onnx
*.pt
*.pth
*.safetensors
*.tar
*.tar.gz
*.zip

# Machine-local datasets, outputs and execution records
/artifacts/
/data/
/dual_task_diagnostics/
/execution/
/experiments/
/operations/
/outputs/

# Keep internal research material local. Publish only curated documentation.
/research/
/docs/*
!/docs/training_progress/
!/docs/training_progress/**

# Draft paper and local progress logs are not part of the clean code snapshot.
/paper/
/README_POSITIVE_EVIDENCE.md
/README_PROGRESS.md
/STORAGE_POLICY.md

# One-off storage migration helper is intentionally machine-specific.
/scripts/repoint_ssd8_project_symlinks.py

# Never embed nested repositories.
**/.git/

# Re-apply cache/binary rules after the selected research-tree negations.
**/__pycache__/
**/*.py[cod]

# Current WAFT feature-repair documentation and scalar evidence.
!/docs/architecture.md
!/docs/feature-repair.md
!/docs/targets.md
!/docs/results.md
!/docs/usage.md
!/docs/results/
/docs/results/*
!/docs/results/summary.csv
!/docs/results/cases.csv
!/docs/results/evidence.json


# Curated data-location inventory; binary data stays local.
!/docs/data-inventory.md
!/docs/data-inventory.csv


# Runnable repair guide and external dependencies/build outputs.
!/docs/running.md
/external/
/build/
/dist/
*.egg-info/

